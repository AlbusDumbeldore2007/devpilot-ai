# ─────────────────────────────────────────────────────────────
# DevPilot AI — environment configuration
# Copy this file to `server/.env` and fill in real values.
# NEVER commit the real .env file to Git.
# ─────────────────────────────────────────────────────────────

# Server
NODE_ENV=development
PORT=5000

# Frontend origin allowed by CORS (comma-separated for multiple origins)
CLIENT_ORIGIN=http://localhost:5173

# MongoDB — local install or MongoDB Atlas connection string
MONGODB_URI=mongodb://127.0.0.1:27017/devpilot

# ── LLM provider (OpenAI-compatible Chat Completions API) ──
# Works with OpenAI, OpenRouter, Groq, DeepSeek, Together, or a local
# Ollama/LM Studio server that exposes /v1/chat/completions.
AI_API_KEY=your_llm_api_key_here
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini

# Optional: request timeout in milliseconds
AI_TIMEOUT_MS=60000
