# ─────────────────────────────────────────────────────────────
# DevPilot AI — environment configuration
# Copy this file to `server/.env` and fill in real values.
# NEVER commit the real .env file to Git.
# ─────────────────────────────────────────────────────────────

# Server
NODE_ENV=development
PORT=5000
PUBLIC_BASE_URL=http://localhost:5000

# Frontend origin allowed by CORS (comma-separated for multiple origins)
CLIENT_ORIGIN=http://localhost:5173

# PostgreSQL (relational data). The dev-services script starts an embedded
# PGlite server on this address. Point at a real PostgreSQL 16+ with the
# pgvector extension for deployment.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/devpilot?schema=public

# MongoDB — AI conversations, generated plans, knowledge-document metadata
MONGODB_URI=mongodb://127.0.0.1:27017/devpilot

# Redis — caching, rate-limit counters and real-time fan-out support
REDIS_URL=redis://127.0.0.1:6379

# ── Authentication / security ────────────────────────────────
# Generate with: openssl rand -hex 48
JWT_ACCESS_SECRET=replace_with_a_long_random_secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=7
BCRYPT_ROUNDS=10
COOKIE_SECURE=false

# Google OAuth (console.cloud.google.com). Leave blank to disable the button.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5000/api/auth/google/callback

# Rate limits
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=600
AUTH_RATE_MAX=20
AI_RATE_MAX=60

# ── LLM provider (OpenAI-compatible Chat Completions API) ──
# Works with OpenAI, OpenRouter, Groq, DeepSeek, Together, or a local
# Ollama/LM Studio server that exposes /v1/chat/completions.
AI_API_KEY=your_llm_api_key_here
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
AI_TIMEOUT_MS=60000
AI_AGENT_MAX_STEPS=6
AI_PRICE_INPUT_PER_M=0.15
AI_PRICE_OUTPUT_PER_M=0.60

# Embeddings for RAG. Separate credentials are supported for a third-party
# embeddings provider. When unavailable, a deterministic local fallback is
# used (set EMBEDDING_LOCAL_FALLBACK=false to fail instead).
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_LOCAL_FALLBACK=true

# ── File uploads / RAG ───────────────────────────────────────
MAX_UPLOAD_MB=5
RAG_CHUNK_SIZE=900
RAG_CHUNK_OVERLAP=120
RAG_TOP_K=5
# UPLOAD_DIR=./uploads

# ── Integrations ─────────────────────────────────────────────
# Public GitHub API works without a token at a low rate limit.
GITHUB_TOKEN=

# Razorpay TEST MODE ONLY. Never use live keys for the academic demo.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_CURRENCY=INR
RAZORPAY_MODE=test

# ── Feature flags ────────────────────────────────────────────
CRON_ENABLED=true
SSR_ENABLED=true
SOCKETS_ENABLED=true
CACHE_TTL_SECONDS=30
